{
    "__COMMENT__ More Information": "https://github.com/mozilla/policy-templates/blob/master/README.md",
    "policies": {
        "AIControls": {
            "Translations": {
                "Value": "available"
            },
            "PDFAltText": {
                "Value": "blocked"
            },
            "SmartTabGroups": {
                "Value": "blocked"
            },
            "LinkPreviewKeyPoints": {
                "Value": "blocked"
            },
            "SidebarChatbot": {
                "Value": "blocked"
            },
            "SmartWindow": {
                "Value": "blocked"
            },
            "SpeechRecognition": {
                "Value": "blocked"
            }
        },
        "ContentAnalysis": {
            "Enabled": false,
            "InterceptionPoints": {
                "Clipboard": { "Enabled": false },
                "ClipboardCopy": { "Enabled": false },
                "Download": { "Enabled": false },
                "DragAndDrop": { "Enabled": false },
                "FileUpload": { "Enabled": false },
                "Print": { "Enabled": false }
            }
        },
        "DisableDefaultBrowserAgent": true,
        "DisableFeedbackCommands": true,
        "DisableFirefoxStudies": true,
        "DisableRemoteImprovements": true,
        "DisableSetDesktopBackground": false,
        "DisableTelemetry": true,
        "DontCheckDefaultBrowser": true,
        "WebsiteFilter": {
            "Block": [
                "https://localhost/*"
            ],
            "Exceptions": [
                "https://localhost/*"
            ]
        },
        "EncryptedMediaExtensions": {
            "Enabled": false
        },
        "ExtensionSettings": {
            "*": {
                "blocked_install_message": "Kyber Fox does not support language packs.",
                "installation_mode": "allowed",
                "allowed_types": ["dictionary", "extension", "sitepermission", "theme"]
            }
        },
        "FirefoxHome": {
            "Weather": false,
            "TopSites": true,
            "SponsoredTopSites": false,
            "Highlights": false,
            "Stories": false,
            "SponsoredStories": false
        },
        "FirefoxSuggest": {
            "WebSuggestions": false,
            "SponsoredSuggestions": false,
            "ImproveSuggest": false
        },
        "LocalNetworkAccess": {
            "Enabled": true,
            "BlockTrackers": true,
            "EnablePrompting": true
        },
        "NoDefaultBookmarks": true,
        "OverridePostUpdatePage": "",
        "SearchEngines": {
            "Add": [
                {
                    "Name": "Startpage",
                    "URLTemplate": "https://www.startpage.com/sp/search?query={searchTerms}",
                    "Method": "GET",
                    "Alias": "@startpage",
                    "Description": "Startpage"
                },
                {
                    "Name": "Brave Search",
                    "URLTemplate": "https://search.brave.com/search?q={searchTerms}",
                    "Method": "GET",
                    "Alias": "@brave",
                    "Description": "Brave Search"
                },
                {
                    "Name": "Ecosia",
                    "URLTemplate": "https://www.ecosia.org/search?q={searchTerms}",
                    "Method": "GET",
                    "Alias": "@ecosia",
                    "Description": "Ecosia"
                }
            ],
            "Default": "DuckDuckGo",
            "DefaultPrivate": "DuckDuckGo",
            "Remove": ["Bing", "eBay", "Perplexity", "Reddit", "Wikipedia (en)", "YouTube"]
        },
        "SkipTermsOfUse": true,
        "SupportMenu": {
            "Title": "Kyber Fox Issue Tracker",
            "URL": "https://github.com/Commanderx-code/KyberFox/issues"
        },
        "UserMessaging": {
            "UrlbarInterventions": false,
            "SkipOnboarding": true,
            "MoreFromMozilla": false,
            "FirefoxLabs": false
        }
    }
}
