# Kyber Fox browser features. Registered in browser/components/moz.build by
# patches/kyber/0001-register-component.patch.

JAR_MANIFESTS += ["jar.mn"]

XPCSHELL_TESTS_MANIFESTS += ["test/xpcshell/xpcshell.toml"]

BROWSER_CHROME_MANIFESTS += ["test/browser/browser.toml"]

EXTRA_JS_MODULES += [
    "KyberPrivacyPresets.sys.mjs",
    "KyberShield.sys.mjs",
    "KyberShieldWidget.sys.mjs",
    "KyberUBlockBridge.sys.mjs",
    "KyberWorkspaces.sys.mjs",
]
