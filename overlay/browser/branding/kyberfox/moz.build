# Kyber Fox branding, derived from Firefox's unofficial branding.

DIRS += ["content", "locales"]

DIST_SUBDIR = "browser"
export("DIST_SUBDIR")

include("../branding-common.mozbuild")
FirefoxBranding()

# Private windows on Linux use the window class and icon kyberfox-private
# (KyberPrivateWindow.sys.mjs). The window icon is looked up here when the
# icon theme has none; the Arch package links these into hicolor.
if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    FINAL_TARGET_FILES.chrome.icons.default += [
        "kyberfox-private128.png",
        "kyberfox-private16.png",
        "kyberfox-private22.png",
        "kyberfox-private24.png",
        "kyberfox-private256.png",
        "kyberfox-private32.png",
        "kyberfox-private48.png",
        "kyberfox-private64.png",
    ]
